# ===== Production-окружение платформы «Технозрелость» =====
# Скопируйте в .env.production и заполните.
# Генерация секретов:  head -c 48 /dev/urandom | base64 | tr -d '/+=' | head -c 48

# --- Приложение ---
APP_ENV=production

# --- База данных ---
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=technozrelost

# --- Auth / JWT (обязательно сгенерировать, НЕ change_me) ---
JWT_SECRET=change_me
NEXTAUTH_SECRET=change_me
# Публичный адрес платформы, например https://platform.cntr18.ru
NEXTAUTH_URL=https://platform.example.ru
# Домены, которым разрешён CORS (через запятую)
CORS_ORIGINS=https://platform.example.ru

# --- LLM (AI-ассистент; ключ кладёт Functional Validator) ---
LLM_API_BASE=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=nemotron-3-ultra-free

# --- Файлы данных (ГОСТы и НИОКТР-выборка копируются в образ при сборке) ---
# После первого запуска выполните внутри backend-контейнера:
#   docker compose -f infra/docker-compose.prod.yml exec backend sh -c \
#     "python -m app.db.seed_gost && python -m app.db.seed_nioktr && python -m app.db.seed_templates"
