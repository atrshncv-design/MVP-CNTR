# ===== Production-окружение платформы «Технозрелость» =====
# Скопируйте в .env.production и заполните.
# Генерация секретов:  head -c 48 /dev/urandom | base64 | tr -d '/+=' | head -c 48

# --- Приложение ---
APP_ENV=production

# --- База данных (Primary — запись) ---
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=technozrelost
# Внутри compose-сети Primary доступен как db:5432; менять не нужно.

# --- Реплика чтения (тикет 18: реестры/каталоги читаются с Replica) ---
# Backend сам соберёт DSN из частей; можно задать и полный DSN ниже.
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_PORT=5432
# Альтернатива — полные DSN (приоритетнее POSTGRES_*):
# DATABASE_URL=postgresql+asyncpg://technoz:change_me_strong_password@db:5432/technozrelost
# DATABASE_REPLICA_URL=postgresql+asyncpg://technoz:change_me_strong_password@db-replica:5432/technozrelost

# --- Стриминг-репликация (только внутренняя сеть compose) ---
REPL_USER=replicator
REPL_PASSWORD=change_me_replica_pass
REPL_SLOT=tz_replica_slot

# --- Auth / JWT (обязательно сгенерировать, НЕ change_me) ---
JWT_SECRET=change_me
NEXTAUTH_SECRET=change_me
# Публичный адрес платформы, например https://platform.cntr18.ru
NEXTAUTH_URL=https://platform.example.ru
# Домены, которым разрешён CORS (через запятую)
CORS_ORIGINS=https://platform.example.ru

# --- LLM (AI-ассистент; ключ кладёт Functional Validator) ---
LLM_API_BASE=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=nemotron-3-ultra-free

# --- MinIO (файлы проектов; тикет 06) ---
MINIO_ACCESS_KEY=technoz
MINIO_SECRET_KEY=change_me_strong_password
MINIO_BUCKET=technozrelost

# --- Файлы данных (ГОСТы и НИОКТР-выборка копируются в образ при сборке) ---
# После первого запуска выполните внутри backend-контейнера:
#   docker compose -f infra/docker-compose.prod.yml exec backend sh -c \
#     "python -m app.db.seed_gost && python -m app.db.seed_nioktr && python -m app.db.seed_templates"
