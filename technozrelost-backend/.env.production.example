# DEPRECATED: используйте technozrelost-backend/infra/.env.production.example как канон (2026-08-31 repo-structure-optimization).
# Этот файл оставлен для обратной совместимости и будет удалён после сверки всех ссылок.
# См. docs/version-map.md и technozrelost-backend/infra/.env.production.example (105 строк, актуальный).

# ===== Production-окружение платформы «Технозрелость» =====
# Скопируйте в .env.production и заполните.
# Генерация секретов:  head -c 48 /dev/urandom | base64 | tr -d '/+=' | head -c 48

# --- Приложение ---
APP_ENV=production

# --- База данных (Primary — запись) ---
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=technozrelost
# Внутри compose-сети Primary доступен как db:5432; менять не нужно.

# --- Реплика чтения (тикет 18: реестры/каталоги читаются с Replica) ---
# Backend сам соберёт DSN из частей; можно задать и полный DSN ниже.
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_PORT=5432
# Альтернатива — полные DSN (приоритетнее POSTGRES_*):
# DATABASE_URL=postgresql+asyncpg://technoz:change_me_strong_password@db:5432/technozrelost
# DATABASE_REPLICA_URL=postgresql+asyncpg://technoz:change_me_strong_password@db-replica:5432/technozrelost

# --- Стриминг-репликация (только внутренняя сеть compose) ---
# REPL_PASSWORD обязателен: compose и init-скрипты падают (fail-fast), если
# не задан или оставлен плейсхолдером.
REPL_USER=replicator
REPL_PASSWORD=change_me_strong_password
REPL_SLOT=tz_replica_slot

# --- Observability (тикет 20; укрепление — тикет 07) ---
# Общий секрет для Prometheus scrape: backend отдаёт /api/v1/metrics только с
# заголовком X-Prometheus-Scrape-Token, равным этому значению. Если оставить
# плейсхолдер/пустым — scrape будет отклоняться (fail-closed).
PROMETHEUS_SCRAPE_TOKEN=change_me_strong_password

# --- Grafana (тикет 07: НЕТ admin/admin по умолчанию) ---
# GRAFANA_ADMIN_USER/GRAFANA_ADMIN_PASSWORD обязательны: без них
# `docker compose config` падает (fail-fast). UI слушает только 127.0.0.1:3001
# (SSH-туннель/VPN; внешний доступ — только через auth-прокси).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# --- Auth / JWT (обязательно сгенерировать, НЕ change_me) ---
# Backend fail-fast: приложение не стартует в production/dev с плейсхолдером.
JWT_SECRET=your-jwt-secret-here-at-least-32-chars
NEXTAUTH_SECRET=change_me
# Публичный адрес платформы, например https://platform.cntr18.ru
NEXTAUTH_URL=https://platform.example.ru
# Домены, которым разрешён CORS (через запятую)
CORS_ORIGINS=https://platform.example.ru

# --- Realtime pub/sub (тикет 05) ---
# REDIS_URL задан -> Redis pub/sub между репликами backend (сервис `redis`
# уже есть в infra/docker-compose.prod.yml); пусто -> локальный in-process
# bus (однопроцессный режим, для 2+ реплик недопустимо).
REDIS_URL=redis://redis:6379/0
# TTL одноразового SSE-тикета (сек); JWT в query-строке SSE не передаётся
SSE_TICKET_TTL_SECONDS=60

# --- LLM (AI-ассистент; ключ кладёт Functional Validator) ---
LLM_API_BASE=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=nemotron-3-ultra-free

# --- MinIO (файлы проектов; тикет 06) ---
MINIO_ACCESS_KEY=technoz
MINIO_SECRET_KEY=change_me_strong_password
MINIO_BUCKET=technozrelost

# --- Файлы данных (ГОСТы и НИОКТР-выборка копируются в образ при сборке) ---
# После первого запуска выполните внутри backend-контейнера:
#   docker compose -f infra/docker-compose.prod.yml exec backend sh -c \
#     "python -m app.db.seed_gost && python -m app.db.seed_nioktr && python -m app.db.seed_templates"
