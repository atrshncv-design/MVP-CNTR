# ── Production-окружение платформы «Технозрелость» ──────────────────────────
# Использование:
#   cp .env.production.example .env.production   # из infra/
#   заполнить значения ниже, затем ./deploy.sh
# Файл .env.production в .gitignore и никогда не коммитится.
# Значения-заглушки change_me_* deploy.sh подсвечивает предупреждением.

# ── PostgreSQL (Primary + Replica) ───────────────────────────────────────────
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=technozrelost

# Стриминг-репликация (создаются автоматически при старте primary)
REPL_USER=replicator
REPL_PASSWORD=change_me_replica_password
REPL_SLOT=tz_replica_slot

# Хост реплики для backend (дефолты compose: db-replica:5432)
# POSTGRES_REPLICA_HOST=db-replica
# POSTGRES_REPLICA_PORT=5432

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
# JWT_SECRET генерируется автоматически при ./deploy.sh, если пуст/заглушка
JWT_SECRET=
# Источники, с которых разрешены CORS-запросы к API (через запятую)
CORS_ORIGINS=https://localhost

# LLM (OpenAI-совместимый API). Без ключа платформа работает, кроме AI-функций.
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# ── MinIO (файлы проектов) ───────────────────────────────────────────────────
MINIO_ACCESS_KEY=technoz
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=technozrelost

# ── Frontend (Next.js / NextAuth) ────────────────────────────────────────────
# Публичный адрес сайта (то, что в браузере); за nginx — схема https и домен
NEXTAUTH_URL=https://localhost
# NEXTAUTH_SECRET генерируется автоматически при ./deploy.sh, если пуст/заглушка
NEXTAUTH_SECRET=

# ── Наблюдаемость (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password

# ── Бэкапы перед миграциями ──────────────────────────────────────────────────
BACKUP_BEFORE_MIGRATIONS=1
BACKUP_KEEP=14
