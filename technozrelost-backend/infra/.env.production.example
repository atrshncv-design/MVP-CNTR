# ── Production-окружение платформы «Технозрелость» ──────────────────────────
# Использование:
#   cp .env.production.example .env.production   # из infra/
#   заполнить значения ниже, затем ./deploy.sh
# Файл .env.production в .gitignore и никогда не коммитится.
# Значения-заглушки change_me_* deploy.sh отклоняет до production-запуска.

# ── PostgreSQL Primary (единственная БД P1) ─────────────────────────────────
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=technozrelost

# P1: Replica нет по проекту — чтение реестров идёт в Primary, backend не
# задаёт POSTGRES_REPLICA_HOST, /ready отдаёт Replica not_configured.

# Роль REPLICATION для physical pg_basebackup (создаётся при старте primary).
# REPL_PASSWORD обязателен: compose и init-скрипты падают (fail-fast), если
# не задан или оставлен плейсхолдером.
REPL_USER=replicator
REPL_PASSWORD=change_me_replica_password
# Физический слот репликации: только для HA-контура с Replica. На P1 оставить
# пустым — слот не создаётся и не проверяется (висячих слотов нет).
REPL_SLOT=

# ── Публичный адрес и TLS (таск 07, G40/G41 + R08: свой домен) ──────────────
# Техническое имя на базе IPv4 сервера (старт без покупки домена).
# 1-2-3-4 ниже — пример: подставьте реальный IP сервера через дефисы
# (или точками: 1.2.3.4.sslip.io). localhost deploy-гейт отклоняет.
# Свой домен (R08, после покупки владельцем — см. infra/README-OWN-DOMAIN.md):
# впишите купленное имя ОДНИМ значением в PUBLIC_HOST, NEXTAUTH_URL
# и CORS_ORIGINS ниже — правки кода не нужны, сертификат выпускается
# тем же процессом (infra/tls_issue.sh), старое имя редиректит 301.
# vash-domen.ru — плейсхолдер для примера, гейт его отклоняет.
PUBLIC_HOST=1-2-3-4.sslip.io
# PUBLIC_HOST=vash-domen.ru
# Старое имя переходного периода (необязательно): 301 на PUBLIC_HOST
# по HTTP и HTTPS. После переезда — старое техническое имя, позже убрать.
# LEGACY_PUBLIC_HOST=1-2-3-4.sslip.io
# Email для уведомлений ACME об экспирации (только имя переменной, значение
# вводит владелец вне переписки).
ACME_EMAIL=
# TLS_STAGING=1 — тестовый сертификат для проверки выпуска (недоверенный).

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
# JWT_SECRET генерируется как 256-bit случайное значение при ./deploy.sh, если пуст/заглушка.
# Заданное вручную значение должно быть случайным, не короче 32 символов и не placeholder.
JWT_SECRET=
# Источники, с которых разрешены CORS-запросы к API (через запятую).
# Таск 07: обязан содержать https://<PUBLIC_HOST>, localhost запрещён.
# R08: то же имя, что в PUBLIC_HOST (свой домен — после покупки).
CORS_ORIGINS=https://1-2-3-4.sslip.io

# LLM (OpenAI-совместимый API; прод: OpenCode Go, тот же ключ).
# Без ключа платформа работает, кроме AI-функций.
LLM_API_BASE=https://opencode.ai/zen/go/v1
# Прод 2026-09-21: mimo-v2.5 отвечает 403 на наш ключ, рабочий выбор —
# deepseek-v4-flash (лимит 65 тыс. запросов/мес, retention 0 дней).
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Алиасы того же ключа OpenCode Go (другое имя, то же значение).
OPENCODE_API_KEY=
OPENCODE_ZEN_API_KEY=
# LLM-гейтвей синтеза (N-05): false по умолчанию (fail-closed) — без явного
# true backend не обращается к внешнему LLM даже при живом ключе.
LLM_GATEWAY_ENABLED=false

# ── MinIO (файлы проектов) ───────────────────────────────────────────────────
MINIO_ACCESS_KEY=technoz
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET=technozrelost

# ── Redis (кэш/очереди/rate limiting) ───────────────────────────────────────
# INF-16: обязательный пароль Redis (requirepass); без него prod-контур не стартует.
REDIS_PASSWORD=change_me_redis_password
# P1 (таск 04): потолок памяти Redis с вытеснением least-recently-used;
# preflight сверяет maxmemory с лимитом 256M контейнера в compose.
REDIS_MAXMEMORY=200mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ── Frontend (Next.js / NextAuth) ────────────────────────────────────────────
# Публичный адрес сайта (то, что в браузере). Таск 07: обязан быть
# https://<PUBLIC_HOST> — localhost deploy-гейт отклоняет.
# R08: то же имя, что в PUBLIC_HOST (свой домен — после покупки).
NEXTAUTH_URL=https://1-2-3-4.sslip.io
# NEXTAUTH_SECRET генерируется как 256-bit случайное значение при ./deploy.sh, если пуст/заглушка.
# Заданное вручную значение должно быть случайным, не короче 32 символов и не placeholder.
NEXTAUTH_SECRET=
# Внутренний адрес backend: одинаково передаётся во frontend build arg и
# runtime env для NextAuth/SSR. В обычном Compose оставьте значение по умолчанию.
API_URL_INTERNAL=http://backend:8000
# Необязательный полный origin API для нестандартной схемы. Пусто = same-origin
# (/api/v1 через rewrite nginx/frontend).
NEXT_PUBLIC_API_URL=

# ── Наблюдаемость (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password
# P1 (таск 04): ограниченный ретеншн Prometheus (время и размер);
# preflight требует оба флага в compose.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=10GB

# ── Бэкапы перед миграциями ──────────────────────────────────────────────────
BACKUP_BEFORE_MIGRATIONS=1

# ── Бэкапы: расписание и маркеры (INF-01) ────────────────────────────────────
# Ежедневный автозапуск backup.sh sidecar-таймером (см. RUNBOOK-DATA.md).
# Время запуска "ЧЧ:ММ" в TZ контейнера (в compose задаётся TZ=UTC)
BACKUP_AT=03:15
# Сколько снапшотов хранить локально (retention)
BACKUP_KEEP=7
# Файл-маркер свежести: после полного успеха backup.sh пишет туда ISO-8601
# с офсетом; возраст сверх BACKUP_MAX_AGE_HOURS = авария алертера
BACKUP_FRESHNESS_MARKER=/backups/.backup-freshness
# Порог свежести бэкапа в часах для алертера (читает таск 05)
BACKUP_MAX_AGE_HOURS=25
# В production MinIO обязателен: без него маркер свежести не обновляется.
BACKUP_STRICT_MINIO=1

# ── Бэкапы: offsite-копия через rclone (INF-04) ──────────────────────────────
# Crypt-only rclone-таргет (remote:bucket/path) для снапшотов и WAL.
# Пусто = offsite выключен: sidecar пишет статус warn, алертер горит жёлтым.
# При непустом значении remote ОБЯЗАН быть type=crypt и не иметь truthy
# no_data_encryption (true, 1, yes, on в любом регистре): обычный storage remote
# backup.sh отвергнет без копирования. Конфигурация remote загружается в named volume
# tz-prod-rclone-config по процедуре из README-DEPLOY.md; секреты в этот файл
# и репозиторий не записываются.
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_MARKER=/backups/.offsite-status
# Отдельный свежий маркер непрерывной синхронизации WAL.
WAL_OFFSITE_MARKER=/backups/.wal-offsite-status
WAL_OFFSITE_INTERVAL_SECONDS=60
WAL_OFFSITE_MAX_AGE_SECONDS=300
# R06i группа F: свежесть локального WAL-архива отдельно от маркера синка.
# Остановленная архивация при успешных синках даёт critical алертера.
WAL_ARCHIVE_DIR=/wal-archive
WAL_ARCHIVE_MAX_AGE_SECONDS=300
# Сколько полных суток WAL хранить локально после успешной offsite-отправки.
WAL_ARCHIVE_KEEP_DAYS=7

# ── Алертер: health probes storage ───────────────────────────────────────────
# Только адреса/имя сервиса, credentials MinIO и ClamAV не нужны.
ALERTER_MINIO_HEALTH_URL=http://minio:9000/minio/health/live
ALERTER_CLAMAV_HOST=clamav
ALERTER_CLAMAV_PORT=3310
# L-03 / INF-18: максимальный возраст CVD-баз ClamAV (секунды, 7 дней).
# Единый источник — app/core/config.py cvd_max_age_seconds; alerter читает тот же env (M4 TICKET-06).
CVD_MAX_AGE_SECONDS=604800

# ── Telegram-уведомления алертера ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
