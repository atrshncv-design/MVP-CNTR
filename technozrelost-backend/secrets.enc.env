# secrets.enc.env — SOPS+age шифрованные секреты (ADR 0013)
# Расшифровка: sops exec-env secrets.enc.env 'printenv'  или  sops --decrypt secrets.enc.env > .env.production
# Ключ age храните в 1Password/pass (23-); файл коммитится, plaintext secrets — никогда.
# Plaintext значения ниже — ENC[...] заглушки, замените при деплое реальным sops --encrypt.

JWT_SECRET_enc: ENC[AES256_GCM,data:dummy0placeholder0for0local0dev0jwt0secret0do0not0use0in0prod,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]
REPL_PASSWORD_enc: ENC[AES256_GCM,data:dummy0repl0password0placeholder0replace0with0sops0age,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]
POSTGRES_PASSWORD_enc: ENC[AES256_GCM,data:dummy0pg0password0placeholder0sops0encrypted,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]
MINIO_SECRET_KEY_enc: ENC[AES256_GCM,data:dummy0minio0secret0placeholder0sops,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]
GRAFANA_ADMIN_PASSWORD_enc: ENC[AES256_GCM,data:dummy0grafana0password0placeholder,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]
LLM_API_KEY_enc: ENC[AES256_GCM,data:dummy0llm0api0key0placeholder0if0used,iv:AAAAAAAAAAAAAAAAAAAAAA==,tag:AAAAAAAAAAAAAAAAAAAAAA==,type:str]

# sops 3.9.0 — метаданные (age получатель — замените на реальный)
sops:
    age:
        - recipient: age1ql3z7hjknz8xys6q3y9example0placeholder0recipient0key0for0local0dev0only0replace0me
          enc: |
            -----BEGIN AGE ENCRYPTED FILE-----
            placeholder ciphertext — сгенерируйте реальный: sops --encrypt --age age1... --in-place secrets.enc.env
            -----END AGE ENCRYPTED FILE-----
    encrypted_suffix: _enc
    version: 3.9.0
