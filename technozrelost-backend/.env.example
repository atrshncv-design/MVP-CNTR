# App
APP_ENV=dev
APP_NAME=technozrelost-backend
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Primary DB (запись)
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me
POSTGRES_DB=technozrelost
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Replica DB (чтение)
POSTGRES_REPLICA_HOST=127.0.0.1
POSTGRES_REPLICA_PORT=5433

# Схемы
DB_SCHEMA_PUBLIC=public
DB_SCHEMA_TEST=test

# RAG / pgvector
VECTOR_DIMENSION=1536

# Auth / JWT (NextAuth.js Credentials-провайдер верифицируется здесь)
# НЕ заполняйте плейсхолдером как есть: в non-test приложение не стартует
# без реального секрета (>=32 символов). Генерация: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# Realtime pub/sub (тикет 05): REDIS_URL задан -> Redis pub/sub между
# репликами backend; пусто -> локальный in-process bus (однопроцессный
# режим; для 2+ реплик обязательно задайте REDIS_URL).
# Пример (локальный Redis): REDIS_URL=redis://127.0.0.1:6379/0
#REDIS_URL=
# TTL одноразового SSE-тикета (сек); JWT в query-строке SSE не передаётся.
#SSE_TICKET_TTL_SECONDS=60
# Rate limits (тикет 06): ограничители ресурсов. В тестах RATE_LIMIT_ENABLED=false
# (выставляет conftest); в prod лимиты действуют. Лимиты — запросов в минуту
# на ключ (IP или IP:account) через Redis (REDIS_URL) либо локальный счётчик.
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_AUTH_PER_MINUTE=10
#RATE_LIMIT_RAG_PER_MINUTE=30
#RATE_LIMIT_UPLOAD_PER_MINUTE=20
#RATE_LIMIT_REGISTRY_PER_MINUTE=60
# Конкурентность embed-вызовов (CPU-работа) в RAG-сервисе.
#EMBEDDING_CONCURRENCY=4
