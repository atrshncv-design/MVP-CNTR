# App
APP_ENV=dev
APP_NAME=technozrelost-backend
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Primary DB (запись)
POSTGRES_USER=technoz
POSTGRES_PASSWORD=change_me
POSTGRES_DB=technozrelost
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Replica DB (чтение)
POSTGRES_REPLICA_HOST=127.0.0.1
POSTGRES_REPLICA_PORT=5433

# Схемы
DB_SCHEMA_PUBLIC=public
DB_SCHEMA_TEST=test

# RAG / pgvector
VECTOR_DIMENSION=1536

# Auth / JWT (NextAuth.js Credentials-провайдер верифицируется здесь)
JWT_SECRET=change_me_super_secret_at_least_32_chars_long_for_hs256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000