# Шаблон переменных окружения фронтенда (значения НЕ коммитятся).
# Реальные значения — только в локальном .env / секретах деплоя.

# Секрет подписи сессий NextAuth v5 (обязателен в production).
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=

# URL бэкенда для браузера (клиентские компоненты, NEXT_PUBLIC_* инлайнится
# в бандл — хранить здесь только адрес, никогда не секреты).
NEXT_PUBLIC_API_URL=

# URL бэкенда для серверных компонентов/роутов (не инлайнится в бандл).
API_URL_INTERNAL=

# LLM rerank для matching — контур tuno без ПДн (P2, R03).
# LLM_API_BASE — базовый URL OpenAI-совместимого API (без /v1/chat/completions).
# Без LLM_API_KEY — сразу script fallback, без запроса (без ПДн в LLM).
NEXT_PUBLIC_LLM_API_BASE=
LLM_API_BASE=
NEXT_PUBLIC_LLM_API_KEY=
LLM_API_KEY=
NEXT_PUBLIC_LLM_MODEL=
LLM_MODEL=
